# ---------------------------------------------------------------------------
# vasp-auto .gitignore
# Keep the repo to source + tests + docs + examples. Everything below is heavy,
# machine-specific, generated, or license-restricted and must NOT be published.
# ---------------------------------------------------------------------------

# VASP pseudopotentials — proprietary, licensed; users supply their own.
POTCAR/

# MLIP weights and dataset shards — Meta owns the UMA/OMat24/OC20/OC22/OC25/ODAC
# licence (gated repo facebook/UMA); each user downloads their own after being
# granted access. They normally live in ~/.cache/fairchem, outside the repo —
# these rules only stop a stray copy or a repo-local cache from being published.
.cache/
fairchem_cache/
*.pt
*.pth
*.ckpt
*.safetensors
*.lmdb
*.aselmdb

# Calculation inputs/outputs and run artifacts (large, machine-specific).
jobs/
inputs/
TSS/
ui_logs/
vasp_auto_background_logs/
*_logs/
*.log

# Local machine config / private remote infrastructure. Ship the *.example only.
config.yaml
remotes.json

# Python virtual environments and build artifacts.
venv/
.venv/
build/
dist/
*.egg-info/
src/*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/

# Editors / OS / tooling cruft.
.trash_*/
.local-apt/
ase-gui
*:Zone.Identifier

# Stray scratch files left under src/.
src/CRASH
src/MEMO.txt
src/input_tmp.in

# Knowledge-graph output (`graphify`): regenerated from the source it indexes and
# rewritten on every query, so committing it is churn. Matches at any depth —
# there is a second tree under src/vasp_auto/.
graphify-out/
