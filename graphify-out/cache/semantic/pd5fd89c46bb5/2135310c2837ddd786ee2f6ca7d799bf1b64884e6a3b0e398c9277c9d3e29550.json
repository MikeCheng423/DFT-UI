{"nodes": [{"id": "docs_tutorial_catalysis", "label": "Tutorial - Catalysis (HER on Pt)", "file_type": "document", "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tutorial_catalysis_adsorption_energy", "label": "Adsorption energy (three-job)", "file_type": "concept", "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E_ads = E(slab+ads) - E(slab) - scale*E(gas); all three energies must share ENCUT, k-density, smearing and pseudopotentials. --molecule-scale 0.5 references atomic H to half E(H2) for HER."}, {"id": "docs_tutorial_catalysis_che", "label": "Computational hydrogen electrode (CHE)", "file_type": "concept", "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mu(H+ + e-) = half mu(H2) at U=0 vs RHE, shifted by +eU. Free energies add ZPE+U_vib-TS from freq jobs; a good HER catalyst has dG_H* approx 0."}, {"id": "docs_tutorial_catalysis_dband_center", "label": "d-band center", "file_type": "concept", "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First moment of the surface-atom d-projected DOS relative to E_F; higher (less negative) centers bind adsorbates more strongly."}, {"id": "docs_tutorial_catalysis_bader", "label": "Bader charges", "file_type": "concept", "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Net charge = ZVAL(POTCAR) - Bader electrons; needs AECCAR0/AECCAR2 (LAECHG) and the Henkelman bader binary on PATH."}, {"id": "docs_tutorial_catalysis_chg_diff", "label": "Charge-density difference (delta-rho)", "file_type": "concept", "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "delta-rho = rho(slab+ads) - rho(slab) - rho(ads); the three densities must be on identical FFT grids, so fragments are carved from the combined relaxed geometry without moving anything. --chg-diff refuses mismatched grids loudly."}], "edges": [{"source": "docs_tutorial_catalysis", "target": "docs_manual_convergence_scan", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "weight": 1.0}, {"source": "docs_tutorial_catalysis", "target": "docs_manual_structure_building", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "weight": 1.0}, {"source": "docs_tutorial_catalysis", "target": "docs_manual_workflow_chaining", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "weight": 1.0}, {"source": "docs_tutorial_catalysis", "target": "docs_manual_ml_prerelax", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "weight": 1.0}, {"source": "docs_tutorial_catalysis", "target": "docs_manual_implicit_solvation", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "weight": 1.0}, {"source": "docs_tutorial_catalysis", "target": "docs_tutorial_07_neb", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/TUTORIAL_CATALYSIS.md", "source_location": null, "weight": 1.0}, {"source": "docs_tutorial_catalysis", "target": "docs_tutorial_08_work_function", "relati